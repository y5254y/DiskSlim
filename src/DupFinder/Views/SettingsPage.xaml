<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DupFinder.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">

            <!-- 语言设置 -->
            <TextBlock x:Uid="SettingsPageLangTitle"
                       Text="界面语言"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Uid="SettingsPageLangLabel" Text="显示语言"
                                   Style="{StaticResource BodyTextBlockStyle}"/>
                        <TextBlock x:Uid="SettingsPageLangDesc"
                                   Text="更改后重启应用生效"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="130"
                              ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"/>
                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.ApplyLanguageCommand}">
                        <TextBlock x:Uid="SettingsPageApplyText" Text="应用"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 扫描默认设置 -->
            <TextBlock x:Uid="SettingsPageScanTitle"
                       Text="扫描默认设置"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="SettingsPageSkipHiddenLabel" Text="跳过隐藏文件"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock x:Uid="SettingsPageSkipHiddenDesc"
                                       Text="忽略以「.」开头或系统标记为隐藏的文件"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.DefaultSkipHidden, Mode=TwoWay}"
                                      OnContent="" OffContent=""/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="SettingsPageSkipSystemLabel" Text="跳过系统文件"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock x:Uid="SettingsPageSkipSystemDesc"
                                       Text="忽略系统属性标记的文件，避免误删关键文件"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.DefaultSkipSystem, Mode=TwoWay}"
                                      OnContent="" OffContent=""/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="SettingsPageSubdirLabel" Text="默认包含子文件夹"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock x:Uid="SettingsPageSubdirDesc"
                                       Text="扫描时默认递归处理所有子目录"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.DefaultIncludeSubdirs, Mode=TwoWay}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <TextBlock x:Uid="SettingsPageAboutTitle"
                       Text="关于"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE8C8;"
                              FontSize="48"
                              Foreground="{ThemeResource SystemAccentColor}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.AppName}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.AppDescription}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="SettingsPageVersionPrefix" Text="版本："
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
