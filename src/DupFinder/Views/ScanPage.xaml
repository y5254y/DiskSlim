<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DupFinder.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DupFinder.Views"
    xmlns:models="using:DupFinder.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0：文件夹选择 ── -->
        <Border Grid.Row="0"
                Padding="16,12"
                
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Uid="ScanPageFolderLabel"
                           Text="扫描文件夹："
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"/>

                <TextBox Grid.Column="1"
                         PlaceholderText="输入文件夹路径，多个路径用分号隔开"
                         Text="{x:Bind ViewModel.ScanFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.BrowseFolderCommand}"
                        ToolTipService.ToolTip="选择文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        <TextBlock x:Uid="ScanPageBrowseText" Text="浏览"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Row 1：扫描选项 ── -->
        <Grid Grid.Row="1" Padding="16,8" ColumnSpacing="16"
              
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 最小文件大小 -->
            <TextBlock Grid.Column="0"
                       x:Uid="ScanPageMinSizeLabel"
                       Text="最小文件："
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
            <ComboBox Grid.Column="1"
                      Width="90"
                      ItemsSource="{x:Bind ViewModel.MinSizeOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedMinSize, Mode=TwoWay}"/>

            <!-- 文件类型 -->
            <TextBlock Grid.Column="2"
                       x:Uid="ScanPageFileTypeLabel"
                       Text="文件类型："
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
            <ComboBox Grid.Column="3"
                      Width="110"
                      ItemsSource="{x:Bind ViewModel.FileTypeOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedFileType, Mode=TwoWay}"/>

            <!-- 子目录开关 -->
            <CheckBox Grid.Column="4"
                      x:Uid="ScanPageSubdirCheck"
                      Content="包含子文件夹"
                      IsChecked="{x:Bind ViewModel.IncludeSubdirectories, Mode=TwoWay}"
                      VerticalAlignment="Center"/>

            <!-- 分隔 -->
            <Rectangle Grid.Column="5" Width="1" Height="20"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       VerticalAlignment="Center" Margin="4,0"/>

            <!-- 扫描按钮 -->
            <Button Grid.Column="7"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing Width="14" Height="14"
                                  IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <FontIcon Glyph="&#xE721;" FontSize="14"
                              Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock x:Uid="ScanPageStartScanText" Text="开始扫描"/>
                </StackPanel>
            </Button>

            <!-- 取消按钮 -->
            <Button Grid.Column="8"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="4,0,0,0">
                <TextBlock x:Uid="ScanPageCancelText" Text="取消"/>
            </Button>
        </Grid>

        <!-- ── Row 2：进度条 ── -->
        <Grid Grid.Row="2">
            <!-- 扫描进度条 -->
            <ProgressBar
                Value="{x:Bind ViewModel.ScanProgressValue, Mode=OneWay}"
                Maximum="100"
                Height="3"
                IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- ── Row 3：批量操作工具栏（有结果时显示） ── -->
        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="8"
              Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 快速选择按钮 -->
            <Button Grid.Column="0" Command="{x:Bind ViewModel.SelectAllDuplicatesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE73A;" FontSize="12"/>
                    <TextBlock x:Uid="ScanPageSelectAllDupText" Text="选择所有副本"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.KeepNewestCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE787;" FontSize="12"/>
                    <TextBlock x:Uid="ScanPageKeepNewestText" Text="保留最新"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.KeepOldestCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE81C;" FontSize="12"/>
                    <TextBlock x:Uid="ScanPageKeepOldestText" Text="保留最旧"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Command="{x:Bind ViewModel.SelectNoneCommand}">
                <TextBlock x:Uid="ScanPageSelectNoneText" Text="取消全选"/>
            </Button>

            <!-- 分隔线 -->
            <Rectangle Grid.Column="4" Width="1" Height="20"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       VerticalAlignment="Center" Margin="4,0"/>

            <!-- 已选统计 -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" FontWeight="Bold"/>
                <TextBlock x:Uid="ScanPageSelectedSuffix" Text="个文件已选，合计"/>
                <TextBlock Text="{x:Bind ViewModel.TotalSelectedSizeText, Mode=OneWay}"
                           FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
            </StackPanel>

            <!-- 删除按钮 -->
            <Button Grid.Column="6"
                    Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                    IsEnabled="{x:Bind ViewModel.IsDeleting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing Width="14" Height="14"
                                  IsActive="{x:Bind ViewModel.IsDeleting, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsDeleting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                              Visibility="{x:Bind ViewModel.IsDeleting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock x:Uid="ScanPageMoveToRecycleBin" Text="移到回收站"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ── Row 4：重复文件组列表 / 空状态 ── -->
        <Grid Grid.Row="4">

            <!-- 有结果时：滚动列表 -->
            <ScrollViewer
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Padding="16,8">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DuplicateGroup">
                            <!-- 每个重复组卡片 -->
                            <Expander IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,4">
                                <Expander.Header>
                                    <!-- 组标题 -->
                                    <Grid ColumnSpacing="12" Padding="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                <TextBlock Text="{x:Bind Count}"
                                                           FontWeight="Bold" FontSize="13"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                                <TextBlock Text="个重复" FontSize="13"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FileSizeText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <TextBlock Text="·"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{x:Bind HashShort}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE896;" FontSize="11"
                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                <TextBlock Text="可节省" FontSize="12"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                <TextBlock Text="{x:Bind WasteBytesText}"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <!-- 组内文件列表 -->
                                <ListView ItemsSource="{x:Bind Files}"
                                          SelectionMode="None">
                                    <!-- 表头 -->
                                    <ListView.Header>
                                        <Grid Padding="8,6" ColumnSpacing="8"
                                              Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="选择"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text=" " Width="20"/>
                                            <TextBlock Grid.Column="2" Text="文件路径"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="大小"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="最后修改"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="操作"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DuplicateFileItem">
                                            <Grid Padding="8,6" ColumnSpacing="8"
                                                  >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 勾选框（keeper 不可勾选） -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind IsKeeper, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                          Width="36"/>

                                                <!-- 文件图标 -->
                                                <FontIcon Grid.Column="1"
                                                          Glyph="{x:Bind Extension, Converter={StaticResource ExtensionToIconConverter}}"
                                                          FontSize="16"
                                                          VerticalAlignment="Center"/>

                                                <!-- 文件名 + 路径 -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- 保留徽章 -->
                                                        <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                                CornerRadius="3" Padding="4,1"
                                                                Visibility="{x:Bind IsKeeper, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="保留" FontSize="11"
                                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Directory}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- 文件大小 -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{x:Bind SizeBytesText}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>

                                                <!-- 最后修改时间 -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{x:Bind LastModifiedText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"/>

                                                <!-- 在资源管理器中打开 -->
                                                <Button Grid.Column="5"
                                                        Width="40"
                                                        Padding="4"
                                                        Click="OpenInExplorer_Click"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="在资源管理器中打开">
                                                    <FontIcon Glyph="&#xEC50;" FontSize="13"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 无结果 / 初始状态 -->
            <StackPanel
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <!-- 扫描中：转圈 -->
                <ProgressRing Width="56" Height="56"
                              IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <!-- 空闲：说明图标 -->
                <FontIcon Glyph="&#xE8C8;" FontSize="64"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Uid="ScanPageEmptyHint"
                           Text="选择要扫描的文件夹，点击「开始扫描」按钮查找重复文件"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- ── Row 5：底部状态栏 ── -->
        <Border Grid.Row="5"
                Padding="16,6"
                
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Uid="ScanPageTotalGroupsPrefix" Text="共"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalGroupCount, Mode=OneWay}"
                               FontWeight="Bold"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock x:Uid="ScanPageTotalGroupsSuffix" Text="组重复  ·  可节省"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalWasteBytesText, Mode=OneWay}"
                               FontWeight="Bold"
                               Foreground="{ThemeResource SystemAccentColor}"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
